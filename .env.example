# ── BBR FREEDO Environment Configuration ──────────────────────────────────────

# Environment Mode: 'development' | 'testing' | 'production'
VITE_APP_ENV=production

# Supabase (Optional Database / Sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Firebase Authentication & Document Cloud (Client Configuration) ───────────
# Client keys identify the project in Google Cloud. Protection is enforced by
# Firebase App Check and Firestore / Storage Security Rules.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ── Firebase App Check ────────────────────────────────────────────────────────
# reCAPTCHA v3 or Enterprise site key for web App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key
# Set to 'true' or a specific UUID debug token ONLY during local testing/dev
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=false

# ── Security Testing Mode ─────────────────────────────────────────────────────
# When true, isolates test accounts and enables safe diagnostic audit panel
VITE_SECURITY_TESTING_MODE=false

# ── Server-Side API Secrets (Vercel Serverless Functions) ──────────────────────
# NEVER prefix backend secrets with VITE_ to prevent leaking into frontend bundles!
ADMIN_SECRET=your-secure-admin-secret-key-32-chars-long
ALLOW_TEST_OTP_RESPONSE=false

# ── Official DigiLocker OAuth 2.0 ─────────────────────────────────────────────
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret
DIGILOCKER_REDIRECT_URI=https://your-domain.vercel.app/api/digilocker/callback
